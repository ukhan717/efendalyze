# ──────────────────────────────────────────────────────────────────────────────
# Efendalyze — Environment Variables
# Copy this file to .env.local and fill in all values before running.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, Railway, or self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/efendalyze?schema=public"

# ── Redis (for BullMQ job queue) ──────────────────────────────────────────────
# Redis URL (Upstash, Railway Redis, or self-hosted)
REDIS_URL="redis://localhost:6379"

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Create a Clerk app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ── Storage (Optional — for persisting screenshots) ───────────────────────────
# If using Supabase Storage:
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="screenshots"

# If using AWS S3:
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="efendalyze-screenshots"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
